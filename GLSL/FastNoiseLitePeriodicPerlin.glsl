float fnlp_quintic(float t) { return t*t*t*(t*(t*6.0-15.0)+10.0); }
float fnlp_gradient(uint seed, uint x, uint y, uint z, vec3 delta, uint dimensions) {
    uint h = fnlp_hash(seed,x,y,z);
    h ^= h >> 15;
    if (dimensions == 2u) {
        uint i = h & 254u;
        return delta[0]*FNLP_GRADIENTS_2D[i] + delta[1]*FNLP_GRADIENTS_2D[i+1u];
    }
    uint i = h & 252u;
    return delta[0]*FNLP_GRADIENTS_3D[i] + delta[1]*FNLP_GRADIENTS_3D[i+1u]
         + delta[2]*FNLP_GRADIENTS_3D[i+2u];
}
float fnlPeriodicPerlin(uint seed, vec3 p, uvec3 period, uint dimensions) {
    uvec3 c0=uvec3(0), c1=uvec3(0);
    vec3 delta=vec3(0), t=vec3(0);
    float v[8];
    for(uint a=0u; a<dimensions; a++) {
        float cell=floor(p[a]);
        c0[a]=fnlp_wrap(int(cell),period[a]);
        c1[a]=(c0[a]+1u)%period[a];
        delta[a]=p[a]-cell;
        t[a]=fnlp_quintic(delta[a]);
    }
    for(uint i=0u; i<(1u<<dimensions); i++) {
        vec3 d=delta-vec3(float(i&1u),float((i>>1)&1u),float((i>>2)&1u));
        v[i]=fnlp_gradient(seed,(i&1u)!=0u?c1[0]:c0[0],
                              (i&2u)!=0u?c1[1]:c0[1],
                              (i&4u)!=0u?c1[2]:c0[2],d,dimensions);
    }
    float xy0=fnlp_lerp(fnlp_lerp(v[0],v[1],t[0]),fnlp_lerp(v[2],v[3],t[0]),t[1]);
    if(dimensions==2u) return xy0*1.4247691104677813;
    float xy1=fnlp_lerp(fnlp_lerp(v[4],v[5],t[0]),fnlp_lerp(v[6],v[7],t[0]),t[1]);
    return fnlp_lerp(xy0,xy1,t[2])*0.964921414852142333984375;
}
